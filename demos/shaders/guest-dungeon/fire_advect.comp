#version 450
layout(local_size_x=256) in;
struct Volume{uvec4 grid;};layout(set=0,binding=0,std430)buffer Atlas{uint atlas[];};layout(set=0,binding=1,std430)readonly buffer Volumes{Volume volumes[];};layout(set=0,binding=2,std430)buffer Emission{uint emission[];};layout(set=0,binding=3,std140)uniform Step{uvec4 dispatch;vec4 clock;};
uint total(){Volume v=volumes[dispatch.y-1];return v.grid.x+v.grid.y*v.grid.z*v.grid.w;}uint volumeOf(uint i){for(uint v=0;v<dispatch.y;v++){Volume q=volumes[v];if(i<q.grid.x+q.grid.y*q.grid.z*q.grid.w)return v;}return 0;}uvec3 coord(uint i,Volume v){uint n=i-v.grid.x;return uvec3(n%v.grid.y,(n/v.grid.y)%v.grid.z,n/(v.grid.y*v.grid.z));}uint idx(ivec3 p,Volume v){p=clamp(p,ivec3(0),ivec3(v.grid.yzw)-1);return v.grid.x+uint(p.x)+uint(p.y)*v.grid.y+uint(p.z)*v.grid.y*v.grid.z;}
vec3 vel(uint i,uint n){uint at=2*n+i*2;return vec3(unpackHalf2x16(atlas[at]),unpackHalf2x16(atlas[at+1]).x);}vec3 scalar(uint i,uint n){uint at=6*n+i*2;return vec3(unpackHalf2x16(atlas[at]),unpackHalf2x16(atlas[at+1]).x);}
vec3 sampleV(vec3 p,Volume v,uint n){ivec3 a=ivec3(floor(p));vec3 f=fract(p),r=vec3(0);for(int z=0;z<2;z++)for(int y=0;y<2;y++)for(int x=0;x<2;x++){vec3 w=mix(1.-f,f,vec3(x,y,z));r+=vel(idx(a+ivec3(x,y,z),v),n)*w.x*w.y*w.z;}return r;}
vec3 sampleS(vec3 p,Volume v,uint n){ivec3 a=ivec3(floor(p));vec3 f=fract(p),r=vec3(0);for(int z=0;z<2;z++)for(int y=0;y<2;y++)for(int x=0;x<2;x++){vec3 w=mix(1.-f,f,vec3(x,y,z));r+=scalar(idx(a+ivec3(x,y,z),v),n)*w.x*w.y*w.z;}return r;}
void main(){uint i=gl_GlobalInvocationID.x,n=total();if(i>=n)return;uint vi=volumeOf(i);Volume v=volumes[vi];vec3 p=vec3(coord(i,v));vec3 u=vel(i,n),back=p-u*clock.x*vec3(v.grid.yzw);vec3 av=sampleV(back,v,n),pred=sampleS(back,v,n),reverse=sampleS(back+sampleV(back,v,n)*clock.x*vec3(v.grid.yzw),v,n),corrected=pred+.5*(scalar(i,n)-reverse);vec3 lo=vec3(1e9),hi=vec3(-1e9);ivec3 a=ivec3(floor(back));for(int z=0;z<2;z++)for(int y=0;y<2;y++)for(int x=0;x<2;x++){vec3 q=scalar(idx(a+ivec3(x,y,z),v),n);lo=min(lo,q);hi=max(hi,q);}corrected=clamp(corrected,lo,hi)*vec3(.998,.999,.997);atlas[i*2]=packHalf2x16(av.xy);atlas[i*2+1]=packHalf2x16(vec2(av.z,0));atlas[4*n+i*2]=packHalf2x16(corrected.xy);atlas[4*n+i*2+1]=packHalf2x16(vec2(corrected.z,0));atomicAdd(emission[vi],uint(clamp(corrected.x,0.,4.)*16383.));}
