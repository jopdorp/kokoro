layout(local_size_x=256) in;struct VolumePixel{uvec2 emission;uvec2 smoke;};layout(set=0,binding=0,std430)readonly buffer Current{VolumePixel current[];};layout(set=0,binding=1,std430)readonly buffer HistoryIn{VolumePixel history_in[];};layout(set=0,binding=2,std430)writeonly buffer HistoryOut{VolumePixel history_out[];};layout(set=0,binding=3,std430)readonly buffer HDR{uvec2 hdr[];};layout(set=0,binding=4,std430)writeonly buffer VolumeOutput{uvec2 volume_pixels[];};layout(set=0,binding=5,std140)uniform Frame{mat4 vp;mat4 reflected_vp;vec4 eye_time;vec4 right_quality;vec4 up_rt;vec4 river;vec4 moon;vec4 settings;vec4 fog_lights;vec4 grid;mat4 previous_vp;};
vec4 emission(VolumePixel p){return vec4(unpackHalf2x16(p.emission.x),unpackHalf2x16(p.emission.y));}vec4 smoke(VolumePixel p){return vec4(unpackHalf2x16(p.smoke.x),unpackHalf2x16(p.smoke.y));}uint at(ivec2 p,ivec2 size){p=clamp(p,ivec2(0),size-1);return uint(p.y*size.x+p.x);}VolumePixel blendPixel(ivec2 p,ivec2 size){uint i=at(p,size);vec4 e=emission(current[i]),s=smoke(current[i]),loE=e,hiE=e,loS=s,hiS=s;for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++){vec4 a=emission(current[at(p+ivec2(x,y),size)]),b=smoke(current[at(p+ivec2(x,y),size)]);loE=min(loE,a);hiE=max(hiE,a);loS=min(loS,b);hiS=max(hiS,b);}vec2 uv=(vec2(p)+.5)/vec2(size);vec2 ndc=uv*2.-1.;vec3 forward=normalize(cross(up_rt.xyz,right_quality.xyz)),ray=normalize(forward+right_quality.xyz*ndc.x*settings.x/settings.y*.57735-up_rt.xyz*ndc.y*.57735),world=eye_time.xyz+ray*e.w;vec4 clip=previous_vp*vec4(world,1);ivec2 old=ivec2((clip.xy/clip.w*.5+.5)*vec2(size));VolumePixel h=history_in[at(old,size)];e=mix(e,clamp(emission(h),loE,hiE),.5);s=mix(s,clamp(smoke(h),loS,hiS),.85);return VolumePixel(uvec2(packHalf2x16(e.xy),packHalf2x16(e.zw)),uvec2(packHalf2x16(s.xy),packHalf2x16(s.zw)));}
void main(){uint linear=gl_GlobalInvocationID.x,sizeX=uint(settings.x),sizeY=uint(settings.y);if(linear>=sizeX*sizeY)return;ivec2 p=ivec2(int(linear%sizeX),int(linear/sizeX)),halfSize=ivec2(sizeX,sizeY)/2,hp=p/2;VolumePixel centre=blendPixel(hp,halfSize);if(all(equal(p&1,ivec2(0))))history_out[at(hp,halfSize)]=centre;float scene=unpackHalf2x16(hdr[linear].y).y;vec4 e=emission(centre),s=smoke(centre);float edge=clamp((scene-e.w)*8.+.5,0.,1.);vec3 c=e.rgb+s.rgb;float t=mix(1.,s.a,edge);volume_pixels[linear]=uvec2(packHalf2x16(c.xy),packHalf2x16(vec2(c.z,t)));}
