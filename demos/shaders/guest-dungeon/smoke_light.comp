#version 450
layout(local_size_x=256) in;
struct Volume{uvec4 grid;};struct Light{vec4 position;vec4 colour;};layout(set=0,binding=0,std430)buffer Atlas{uint atlas[];};layout(set=0,binding=1,std430)readonly buffer Volumes{Volume volumes[];};layout(set=0,binding=2,std430)readonly buffer Sources{Light sources[];};layout(set=0,binding=3,std140)uniform Step{uvec4 dispatch;vec4 clock;};
uint total(){Volume v=volumes[dispatch.y-1];return v.grid.x+v.grid.y*v.grid.z*v.grid.w;}uint volumeOf(uint i){for(uint v=0;v<dispatch.y;v++){Volume q=volumes[v];if(i<q.grid.x+q.grid.y*q.grid.z*q.grid.w)return v;}return 0;}uvec3 coord(uint i,Volume v){uint n=i-v.grid.x;return uvec3(n%v.grid.y,(n/v.grid.y)%v.grid.z,n/(v.grid.y*v.grid.z));}uint idx(ivec3 p,Volume v){p=clamp(p,ivec3(0),ivec3(v.grid.yzw)-1);return v.grid.x+uint(p.x)+uint(p.y)*v.grid.y+uint(p.z)*v.grid.y*v.grid.z;}
vec3 extent(Light s){return s.position.w>1.?vec3(1.6,3.2,1.6):vec3(.65,1.5,.65)*max(s.position.w/.58,.72);}vec3 origin(Light s){vec3 e=extent(s);return vec3(s.position.x-e.x*.5,s.position.y-(s.position.w>1.?s.position.w:s.position.w*.5),s.position.z-e.z*.5);}float soot(uint i,uint n){uint at=4*n+i*2+1;return unpackHalf2x16(atlas[at]).x;}
void main(){uint i=gl_GlobalInvocationID.x,n=total();if(i>=n)return;uint vi=volumeOf(i);Volume v=volumes[vi];Light s=sources[vi];vec3 o=origin(s),e=extent(s),world=o+(vec3(coord(i,v))+.5)/vec3(v.grid.yzw)*e,to=s.position.xyz-world;float optical=0.;for(int j=0;j<16;j++){vec3 p=(world+to*(float(j)+.5)/16.-o)/e*vec3(v.grid.yzw)-.5;optical+=soot(idx(ivec3(round(p)),v),n);}float trans=exp(-optical*length(to)*.19/16.);vec3 light=s.colour.rgb*trans/max(.18,dot(to,to));uint at=11*n+i*2;atlas[at]=packHalf2x16(light.xy);atlas[at+1]=packHalf2x16(vec2(light.z,trans));}
