#version 450
layout(local_size_x=256) in;
struct Volume{uvec4 grid;};layout(set=0,binding=0,std430)buffer Atlas{uint atlas[];};layout(set=0,binding=1,std430)readonly buffer Volumes{Volume volumes[];};layout(set=0,binding=2,std140)uniform Step{uvec4 dispatch;vec4 clock;};
uint total(){Volume v=volumes[dispatch.y-1];return v.grid.x+v.grid.y*v.grid.z*v.grid.w;}uint volumeOf(uint i){for(uint v=0;v<dispatch.y;v++){Volume q=volumes[v];if(i<q.grid.x+q.grid.y*q.grid.z*q.grid.w)return v;}return 0;}uvec3 coord(uint i,Volume v){uint n=i-v.grid.x;return uvec3(n%v.grid.y,(n/v.grid.y)%v.grid.z,n/(v.grid.y*v.grid.z));}uint idx(ivec3 p,Volume v){p=clamp(p,ivec3(0),ivec3(v.grid.yzw)-1);return v.grid.x+uint(p.x)+uint(p.y)*v.grid.y+uint(p.z)*v.grid.y*v.grid.z;}float pressure(uint i,uint n){return unpackHalf2x16(atlas[10*n+i]).x;}vec3 vel(uint i,uint n){uint at=i*2;return vec3(unpackHalf2x16(atlas[at]),unpackHalf2x16(atlas[at+1]).x);}
void main(){uint i=gl_GlobalInvocationID.x,n=total();if(i>=n)return;Volume v=volumes[volumeOf(i)];ivec3 p=ivec3(coord(i,v));vec3 g=vec3(pressure(idx(p+ivec3(1,0,0),v),n)-pressure(idx(p-ivec3(1,0,0),v),n),pressure(idx(p+ivec3(0,1,0),v),n)-pressure(idx(p-ivec3(0,1,0),v),n),pressure(idx(p+ivec3(0,0,1),v),n)-pressure(idx(p-ivec3(0,0,1),v),n))*.5;vec3 u=vel(i,n)-g;uint at=2*n+i*2;atlas[at]=packHalf2x16(u.xy);atlas[at+1]=packHalf2x16(vec2(u.z,0));}
